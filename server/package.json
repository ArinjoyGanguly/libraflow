{
  "name": "libraflow-server",
  "version": "1.0.0",
  "description": "Express + Node.js + TypeScript REST API for LibraFlow Library Management System backed by Neo4j",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "jest --runInBand --detectOpenHandles"
  },
  "keywords": [
    "library",
    "neo4j",
    "express",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
